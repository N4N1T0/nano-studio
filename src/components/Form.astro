<section class='w-full max-w-2xl mx-auto p-8'>
  <div class='flex flex-col gap-4 menu-col'>
    <!-- HEADER -->
    <div class='text-center space-y-4'>
      <p class='text-primary-foreground text-sm md:text-xl uppercase'>
        let's create something amazing together
      </p>
    </div>

    <!-- FORM -->
    <form id='contact-form' class='flex flex-col gap-4 menu-col'>
      <!-- NAME -->
      <input
        type='text'
        id='name'
        name='name'
        required
        class='w-full px-0 py-4 text-base md:text-lg bg-transparent border-0 border-b text-primary-foreground border-primary-foreground placeholder-primary-foreground/75 focus:border-primary focus:outline-none transition-colors duration-300 ease-out form-item'
        placeholder='Your full name'
        autocomplete='name'
      />

      <!-- EMAIL -->
      <input
        type='email'
        id='email'
        name='email'
        required
        class='w-full px-0 py-4 text-base md:text-lg bg-transparent border-0 border-b text-primary-foreground border-primary-foreground placeholder-primary-foreground/75 focus:border-primary focus:outline-none transition-colors duration-300 ease-out form-item'
        placeholder='your.email@example.com'
        autocomplete='email'
      />

      <!-- MESSAGE -->
      <textarea
        id='message'
        name='message'
        rows='5'
        required
        class='w-full px-0 py-4 text-base md:text-lg bg-transparent border-0 border-b text-primary-foreground border-primary-foreground placeholder-primary-foreground/75 focus:border-primary focus:outline-none transition-colors duration-300 ease-out form-item'
        placeholder='Tell us about your project...'></textarea>

      <!-- BUTTON -->
      <div class='pt-4 md:pt-8 form-item'>
        <button
          id='submit-button'
          type='submit'
          class='group relative w-full md:w-auto px-6 md:px-12 py-2 md:py-4 text-primary bg-primary-foreground font-medium uppercase tracking-wide overflow-hidden transition-all duration-300 ease-out hover:bg-muted-foreground hover:text-primary-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-transparent'
        >
          <span class='relative z-10'>Send Message</span>
          <div
            class='absolute inset-0 bg-muted-foreground transform translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out'
          >
          </div>
        </button>
      </div>
    </form>

    <!-- STATUS -->
    <div
      id='form-status'
      class='hidden p-3 md:p-6 bg-primary-foreground text-center mt-4 md:mt-8'
      aria-live='polite'
    >
      <p class='text-primary font-medium'></p>
    </div>

    <!-- SUCCESS -->
    <div
      id='success-message'
      class='hidden opacity-0 p-3 md:p-6 bg-primary-foreground text-center mt-4 md:mt-8'
    >
      <p class='text-primary font-medium'>
        Thank you for your message! We'll get back to you soon.
      </p>
    </div>
  </div>
</section>

<script>
  import { actions } from 'astro:actions'
  import gsap from 'gsap'
  import { isJibberish, getJibberishMessage } from '@/lib/utils'

  // ELEMENTS
  const form = document.querySelector('#contact-form') as HTMLFormElement
  const status = document.querySelector(
    '#form-status p'
  ) as HTMLParagraphElement
  const successMessage = document.querySelector(
    '#success-message'
  ) as HTMLDivElement
  const submitButton = document.querySelector(
    '#submit-button'
  ) as HTMLButtonElement

  // RESPONSIVENESS
  const isMobile = window.innerWidth < 768
  const textarea = document.querySelector('#message') as HTMLTextAreaElement
  textarea.rows = isMobile ? 3 : 5

  // EVENTS
  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!form || !submitButton) return

    // RESET
    status?.parentElement?.classList.add('hidden')
    status.textContent = ''
    successMessage?.classList.add('hidden')

    // DISABLE
    submitButton.disabled = true
    const originalBtnText = submitButton.querySelector('span')?.textContent
    if (originalBtnText)
      submitButton.querySelector('span')!.textContent = 'Sending...'

    // FORM DATA
    const formData = new FormData(form)

    // CLIENT VALIDATION: gibberish checks
    const nameVal = formData.get('name')?.toString().trim() ?? ''
    const messageVal = formData.get('message')?.toString().trim() ?? ''
    const nameCheck = isJibberish(nameVal)
    const messageCheck = isJibberish(messageVal)

    if (nameCheck.jibberish || messageCheck.jibberish) {
      const msg = nameCheck.jibberish
        ? getJibberishMessage('name', nameCheck.reason)
        : getJibberishMessage('message', messageCheck.reason)
      status.textContent = msg
      status?.parentElement?.classList.remove('hidden')
      submitButton.disabled = false
      if (originalBtnText)
        submitButton.querySelector('span')!.textContent = originalBtnText
      return
    }

    // SUBMIT
    const { error, data } = await actions.contact(formData)

    // ERROR
    if (error) {
      status.textContent =
        error.message ?? 'There was an error sending your message.'
      status?.parentElement?.classList.remove('hidden')
      submitButton.disabled = false
      if (originalBtnText)
        submitButton.querySelector('span')!.textContent = originalBtnText
      return
    }

    // SUCCESS
    if (data?.success) {
      const tl = gsap.timeline({
        defaults: {
          ease: 'power2.out'
        }
      })

      tl.to(
        submitButton.parentElement,
        {
          autoAlpha: 0,
          y: 20,
          duration: 0.5,
          onComplete: () => {
            gsap.set(submitButton.parentElement, { display: 'none' })
          }
        },
        0
      ).fromTo(
        successMessage,
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
          onStart: () => successMessage?.classList.remove('hidden')
        }
      )
      form.reset()

      setTimeout(() => {
        tl.to(successMessage, {
          opacity: 0,
          y: 20,
          duration: 0.5,
          onComplete: () => {
            successMessage?.classList.add('hidden')
          }
        }).fromTo(
          submitButton.parentElement,
          {
            autoAlpha: 0,
            y: 20
          },
          {
            autoAlpha: 1,
            duration: 0.2,
            y: 0,
            onStart: () => {
              gsap.set(submitButton.parentElement, { display: 'block' })
            }
          }
        )
      }, 4000)
    }

    // Re-enable button
    submitButton.disabled = false
    if (originalBtnText)
      submitButton.querySelector('span')!.textContent = originalBtnText
  })
</script>
